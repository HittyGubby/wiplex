# wiplex configuration
# Apply changes with:  sudo systemctl reload wiplex
# (changing WIFI_IF/ETH_IF/AP_IF needs a restart, not a reload)

# --- interfaces --------------------------------------------------------------
# WiFi radio shared between the client uplink and the access point.
# Empty = auto-detect the WiFi interface on the default route.
WIFI_IF=""

# AP interface name (<= 15 chars). Empty = derive "<WIFI_IF>ap".
AP_IF=""

# Wired uplink. Empty = auto-detect (a wired interface carrying the default route).
ETH_IF=""

# --- access point ------------------------------------------------------------
SSID="wiplex"
PSK="ChangeMe_12345"      # empty string = open network (not recommended)

# Regulatory country (ISO alpha-2). Empty = leave the current setting alone.
COUNTRY=""

# Fixed band/channel for WIRED mode. Must be a non-DFS channel
# (5 GHz non-DFS are 36-48 and 149-165).
AP_BAND="5"
AP_CHANNEL="36"

# --- routed subnet -----------------------------------------------------------
AP_IP="192.168.50.1"
AP_CIDR="192.168.50.1/24"
AP_NET="192.168.50.0/24"
DHCP_START="192.168.50.100"
DHCP_END="192.168.50.200"
DHCP_MASK="255.255.255.0"
DHCP_LEASE="12h"

# --- IPv6 for AP clients -----------------------------------------------------
# "off"    : IPv4 only (default).
# "nat66"  : clients get addresses from AP_PREFIX6 and are NAT66'd out the
#            uplink. The host needs a global IPv6 address on its uplink
#            (native IPv6, or a routed tunnel such as WireGuard).
# "routed" : clients get addresses from AP_PREFIX6 and are routed without NAT.
#            The uplink must already route AP_PREFIX6 to this host (for
#            example a /64 from a VPS, or a DHCPv6-PD prefix).
#
# AP_PREFIX6 must be a /64: Android and most SLAAC clients require /64.
# AP_IP6 is the gateway address on the AP; empty = first address (::1).
#
# Example (NAT66 with a ULA, like a VPN-routed uplink):
#   IPV6_MODE="nat66"
#   AP_IP6="fd42:9977:79:2::1"
#   AP_PREFIX6="fd42:9977:79:2::/64"
#
# Example (routed global /64):
#   IPV6_MODE="routed"
#   AP_IP6="2a13:a5c7:3710:abcd::1"
#   AP_PREFIX6="2a13:a5c7:3710:abcd::/64"
IPV6_MODE="off"
AP_IP6=""
AP_PREFIX6=""

# --- DNS ---------------------------------------------------------------------
# "dnsmasq"  : wiplex runs a DNS forwarder on AP_IP (self-contained).
# "external" : DHCP only; clients use DNS_IP (something else already serves
#              :53, e.g. systemd-resolved/unbound/a proxy).
DNS_MODE="dnsmasq"
DNS_IP=""                 # empty = AP_IP
DNS_IP6=""                # empty = AP_IP6
DNS_PORT="53"             # dnsmasq DNS port (dnsmasq mode only)

# --- WiFi-share (duplex) behaviour -------------------------------------------
AVOID_DFS="yes"           # avoid DFS uplink channels automatically
DFS_COOLDOWN="90"         # seconds between DFS-avoidance attempts
STUCK_TIMEOUT="45"        # clear a stuck BSSID pin after this many seconds

# --- wired behaviour ---------------------------------------------------------
# Disconnect the WiFi client while on the wired uplink, so the AP can use a
# fixed channel instead of sharing the client's channel.
FREE_RADIO_ON_WIRED="yes"

# Optional: fix a specific NetworkManager connection for the uplink.
UPLINK_CONN=""
