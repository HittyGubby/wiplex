#!/bin/bash
#
# wiplex - share one WiFi radio between a client (STA) link and an access
#          point (AP). The AP lives on its own routed subnet and NATs out the
#          upstream interface. Config: /etc/wiplex.conf
#
# A single radio cannot run STA and AP on different channels, so when the
# upstream is the WiFi client itself the AP is pinned to the client's channel
# and restarted whenever the client roams.
#
# SPDX-License-Identifier: MIT
set -u

CONF="${WIPLEX_CONF:-/etc/wiplex.conf}"

# ---- defaults (override in $CONF) -------------------------------------------
WIFI_IF=""              # WiFi radio used for the AP (and uplink); empty = autodetect
AP_IF=""                # AP interface name; empty = "<WIFI_IF>ap"
UPSTREAM_IF=""          # NAT egress interface; empty = default-route interface

SSID="wiplex"
PSK=""                  # empty -> open network (not recommended)

COUNTRY=""              # regulatory country, e.g. US/GB/DE; empty = leave as-is
AP_BAND="5"             # fixed band, used only when there is no STA link to follow
AP_CHANNEL="36"         # fixed channel, same case

AP_IP="192.168.50.1"
AP_CIDR="192.168.50.1/24"
AP_NET="192.168.50.0/24"
DHCP_START="192.168.50.100"
DHCP_END="192.168.50.200"
DHCP_MASK="255.255.255.0"
DHCP_LEASE="12h"

DNS_MODE="dnsmasq"      # "dnsmasq" (serve DNS on AP_IP) or "external"
DNS_IP=""               # clients' DNS in external mode; empty = AP_IP
DNS_PORT="53"           # dnsmasq DNS port (dnsmasq mode)

WAIT_FOR_UPLINK_SECS=90 # how long to wait for the STA link before using a fixed channel
NFT_TABLE="wiplex"

# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

DNSMASQ_CONF="/run/wiplex-dnsmasq.conf"
HOSTAPD_CONF="/run/wiplex-hostapd.conf"
DNSMASQ_LOG="/run/wiplex-dnsmasq.log"
HOSTAPD_LOG="/run/wiplex-hostapd.log"
DNSMASQ_LEASE="/run/wiplex-dnsmasq.leases"

HAPD_PID=""
DNSMASQ_PID=""
CHANNEL=""
RELOAD=0
_CLEANED=0

log() { echo "[wiplex] $*"; }
die() { echo "[wiplex] ERROR: $*" >&2; exit 1; }

cleanup() {
    [ "$_CLEANED" = 1 ] && return
    _CLEANED=1
    log "cleaning up"
    [ -n "$HAPD_PID" ] && kill "$HAPD_PID" 2>/dev/null
    [ -n "$DNSMASQ_PID" ] && kill "$DNSMASQ_PID" 2>/dev/null
    nft delete table ip "$NFT_TABLE" 2>/dev/null
    ip addr flush dev "$AP_IF" 2>/dev/null
    iw dev "$AP_IF" del 2>/dev/null
}
on_signal() { cleanup; exit 0; }
trap cleanup EXIT
trap on_signal INT TERM
trap 'RELOAD=1' HUP

# ---- interface discovery ----------------------------------------------------
detect_wifi_if() {
    local d
    d=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
    if [ -n "$d" ] && [ -d "/sys/class/net/$d/wireless" ]; then printf '%s' "$d"; return; fi
    for d in /sys/class/net/*; do
        [ -d "$d/wireless" ] || continue
        d=$(basename "$d")
        case "$d" in p2p-dev-*) continue ;; esac
        iw dev "$d" info 2>/dev/null | grep -q "type managed" || continue
        printf '%s' "$d"; return
    done
}

detect_upstream_if() {
    ip route show default 2>/dev/null | awk '{print $5; exit}'
}

resolve_defaults() {
    [ -n "$WIFI_IF" ]     || WIFI_IF=$(detect_wifi_if)
    [ -n "$UPSTREAM_IF" ] || UPSTREAM_IF=$(detect_upstream_if)
    if [ -z "$AP_IF" ]; then
        if [ -n "$WIFI_IF" ] && [ "$(( ${#WIFI_IF} + 2 ))" -le 15 ]; then
            AP_IF="${WIFI_IF}ap"
        else
            AP_IF="wiplex-ap"
        fi
    fi
    [ -n "$AP_IF" ] || die "no AP interface (set AP_IF in $CONF)"
    [ -n "$DNS_IP" ] || DNS_IP="$AP_IP"
}

# ---- channel helpers --------------------------------------------------------
sta_freq() { iw dev "$WIFI_IF" link 2>/dev/null | awk '/freq:/{print int($2)}'; }
chan_of_freq() { local f=$1; if [ "$f" -ge 5000 ]; then echo $(( (f - 5000) / 5 )); else echo $(( (f - 2407) / 5 )); fi; }
hwmode_of_freq() { local f=$1; if [ "$f" -ge 5000 ]; then echo a; else echo g; fi; }

# ---- AP interface -----------------------------------------------------------
ensure_ap_if() {
    if ! ip link show "$AP_IF" >/dev/null 2>&1; then
        iw dev "$WIFI_IF" interface add "$AP_IF" type __ap || return 1
        command -v nmcli >/dev/null 2>&1 && nmcli device set "$AP_IF" managed no 2>/dev/null
    fi
    if ! ip -4 addr show dev "$AP_IF" 2>/dev/null | grep -q "$AP_IP/"; then
        ip addr add "$AP_CIDR" dev "$AP_IF" 2>/dev/null
    fi
    ip link set "$AP_IF" up
    return 0
}

# ---- dnsmasq (DHCP, optionally DNS) -----------------------------------------
write_dnsmasq_conf() {
    {
        echo "interface=$AP_IF"
        echo "dhcp-range=$DHCP_START,$DHCP_END,$DHCP_MASK,$DHCP_LEASE"
        echo "dhcp-leasefile=$DNSMASQ_LEASE"
        echo "dhcp-option=3,$AP_IP"
        if [ "$DNS_MODE" = "external" ]; then
            echo "port=0"
            echo "dhcp-option=6,$DNS_IP"
        else
            echo "listen-address=$AP_IP"
            echo "bind-interfaces"
            echo "port=$DNS_PORT"
            echo "no-resolv"
            echo "dhcp-option=6,$AP_IP"
            awk '/^nameserver/{print "server="$2}' /etc/resolv.conf
        fi
        echo "log-dhcp"
    } > "$DNSMASQ_CONF"
}

start_dnsmasq() {
    write_dnsmasq_conf
    dnsmasq -k --conf-file="$DNSMASQ_CONF" >>"$DNSMASQ_LOG" 2>&1 &
    DNSMASQ_PID=$!
    log "dnsmasq started (pid $DNSMASQ_PID, dns=$DNS_MODE)"
}

restart_dnsmasq() {
    if [ -n "$DNSMASQ_PID" ]; then
        kill "$DNSMASQ_PID" 2>/dev/null
        wait "$DNSMASQ_PID" 2>/dev/null
    fi
    DNSMASQ_PID=""
    start_dnsmasq
}

# ---- NAT --------------------------------------------------------------------
setup_nat() {
    nft delete table ip "$NFT_TABLE" 2>/dev/null
    nft add table ip "$NFT_TABLE"
    nft add chain ip "$NFT_TABLE" postrouting \
        '{ type nat hook postrouting priority srcnat; policy accept; }'
    nft add rule ip "$NFT_TABLE" postrouting ip saddr "$AP_NET" \
        oifname "$UPSTREAM_IF" masquerade
    sysctl -qw net.ipv4.ip_forward=1
    log "NAT: $AP_NET -> $UPSTREAM_IF"
}

# ---- hostapd ----------------------------------------------------------------
start_hostapd() {
    local ch=$1 mode=$2
    {
        echo "interface=$AP_IF"
        echo "driver=nl80211"
        echo "ssid=$SSID"
        echo "hw_mode=$mode"
        echo "channel=$ch"
        echo "ieee80211n=1"
        [ -n "$COUNTRY" ] && { echo "ieee80211d=1"; echo "ieee80211h=1"; echo "country_code=$COUNTRY"; }
        echo "wpa=2"
        [ -n "$PSK" ] && echo "wpa_passphrase=$PSK"
        echo "wpa_key_mgmt=WPA-PSK"
        echo "rsn_pairwise=CCMP"
    } > "$HOSTAPD_CONF"
    hostapd "$HOSTAPD_CONF" >>"$HOSTAPD_LOG" 2>&1 &
    HAPD_PID=$!
    log "hostapd started on channel $ch (hw_mode=$mode, pid $HAPD_PID)"
}

# ---- reload -----------------------------------------------------------------
reload_all() {
    log "reloading config"
    resolve_defaults
    ip addr flush dev "$AP_IF" 2>/dev/null
    ensure_ap_if
    setup_nat
    restart_dnsmasq
    if [ -n "$HAPD_PID" ]; then
        kill "$HAPD_PID" 2>/dev/null
        wait "$HAPD_PID" 2>/dev/null
    fi
    HAPD_PID=""
    CHANNEL=""
}

# ---- main -------------------------------------------------------------------
resolve_defaults
[ -n "$WIFI_IF" ] || die "no WiFi interface found; set WIFI_IF in $CONF"
[ -n "$UPSTREAM_IF" ] || die "no upstream interface; set UPSTREAM_IF in $CONF"
log "wifi=$WIFI_IF ap=$AP_IF upstream=$UPSTREAM_IF"

[ -n "$COUNTRY" ] && { iw reg set "$COUNTRY" 2>/dev/null || true; }

# If the uplink is the WiFi client, wait for it so the AP can share its channel.
if [ "$UPSTREAM_IF" = "$WIFI_IF" ]; then
    log "waiting up to ${WAIT_FOR_UPLINK_SECS}s for STA link on $WIFI_IF..."
    n=0
    while [ "$n" -lt "$WAIT_FOR_UPLINK_SECS" ]; do
        [ -n "$(sta_freq)" ] && break
        sleep 2; n=$(( n + 2 ))
    done
fi

ensure_ap_if || die "could not create AP interface $AP_IF"
setup_nat
start_dnsmasq

while true; do
    if [ "$RELOAD" = 1 ]; then
        RELOAD=0
        # shellcheck disable=SC1090
        . "$CONF" 2>/dev/null || true
        reload_all
        continue
    fi

    ensure_ap_if >/dev/null 2>&1

    f=$(sta_freq)
    if [ -n "$f" ] && [ "$f" -gt 0 ]; then
        ch=$(chan_of_freq "$f")
        mode=$(hwmode_of_freq "$f")
    else
        ch="$AP_CHANNEL"
        mode=$([ "$AP_BAND" = "5" ] && echo a || echo g)
    fi

    if [ -z "$HAPD_PID" ] || ! kill -0 "$HAPD_PID" 2>/dev/null || [ "$ch" != "$CHANNEL" ]; then
        if [ -n "$HAPD_PID" ]; then
            kill "$HAPD_PID" 2>/dev/null
            wait "$HAPD_PID" 2>/dev/null
        fi
        CHANNEL=$ch
        start_hostapd "$ch" "$mode"
    fi
    sleep 3
done
