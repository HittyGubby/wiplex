#!/bin/bash
#
# wiplex - share the internet as a routed, NATed hotspot from one WiFi radio.
#
# Hybrid uplink:
#   * wired default route present -> use it and free the WiFi radio
#     (STA disconnected, AP on a fixed non-DFS channel)
#   * otherwise                   -> share the WiFi client radio (AP follows
#     the client's channel; DFS channels are avoided conservatively)
#
# SAFETY: the AP interface is always removed *before* the STA is (dis)connected.
# On some Intel firmware, disconnecting the STA while an AP vif exists crashes
# the firmware and can knock the card off the PCIe bus.
#
# Config: /etc/wiplex.conf   (reload with: systemctl reload wiplex)
# SPDX-License-Identifier: MIT
set -u

CONF="${WIPLEX_CONF:-/etc/wiplex.conf}"

# ---- defaults (override in $CONF) -------------------------------------------
WIFI_IF=""              # WiFi radio (AP + client); empty = auto-detect
AP_IF=""                # AP interface; empty = "<WIFI_IF>ap"
ETH_IF=""               # wired uplink; empty = auto-detect default-route iface

SSID="wiplex"
PSK=""                  # empty -> open network (not recommended)

COUNTRY=""              # regulatory country, e.g. US/GB/DE; empty = leave as-is
AP_BAND="5"             # fixed band for wired mode ("5" or "2")
AP_CHANNEL="36"         # fixed NON-DFS channel for wired mode

AP_IP="192.168.50.1"
AP_CIDR="192.168.50.1/24"
AP_NET="192.168.50.0/24"
DHCP_START="192.168.50.100"
DHCP_END="192.168.50.200"
DHCP_MASK="255.255.255.0"
DHCP_LEASE="12h"

DNS_MODE="dnsmasq"      # "dnsmasq" (serve DNS on AP_IP) or "external"
DNS_IP=""               # clients' DNS in external mode; empty = AP_IP
DNS_PORT="53"           # dnsmasq DNS port (dnsmasq mode)

AVOID_DFS="yes"         # in WiFi-share mode, avoid DFS channels
DFS_COOLDOWN="90"       # seconds between DFS-avoidance attempts
FREE_RADIO_ON_WIRED="yes"  # disconnect the client while on wired uplink
STUCK_TIMEOUT="45"      # clear a stuck BSSID pin after this many seconds
UPLINK_CONN=""          # NM connection name/uuid; empty = auto-detect
NFT_TABLE="wiplex"

# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

DNSMASQ_CONF="/run/wiplex-dnsmasq.conf"
HOSTAPD_CONF="/run/wiplex-hostapd.conf"

HAPD_PID=""
DNSMASQ_PID=""
CHANNEL=""
RELOAD=0
_CLEANED=0
MODE=""
UPSTREAM_IF=""
DISCONNECT_SINCE=""

log() { echo "[wiplex] $*"; }
die() { echo "[wiplex] ERROR: $*" >&2; exit 1; }

cleanup() {
    [ "$_CLEANED" = 1 ] && return
    _CLEANED=1
    log "cleaning up"
    stop_hostapd
    [ -n "$DNSMASQ_PID" ] && kill "$DNSMASQ_PID" 2>/dev/null
    nft delete table ip "$NFT_TABLE" 2>/dev/null
    ip addr flush dev "$AP_IF" 2>/dev/null
    iw dev "$AP_IF" del 2>/dev/null
}
on_signal() { cleanup; exit 0; }
trap cleanup EXIT
trap on_signal INT TERM
trap 'RELOAD=1' HUP

# ---- interface discovery ----------------------------------------------------
detect_wifi_if() {
    local d
    d=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
    if [ -n "$d" ] && [ -d "/sys/class/net/$d/wireless" ]; then printf '%s' "$d"; return; fi
    for d in /sys/class/net/*; do
        [ -d "$d/wireless" ] || continue
        d=$(basename "$d")
        case "$d" in p2p-dev-*) continue ;; esac
        iw dev "$d" info 2>/dev/null | grep -q "type managed" || continue
        printf '%s' "$d"; return
    done
}

wired_uplink() {
    local d
    if [ -n "${ETH_IF:-}" ]; then
        if [ -d "/sys/class/net/$ETH_IF" ] \
           && [ "$(cat "/sys/class/net/$ETH_IF/carrier" 2>/dev/null)" = 1 ] \
           && ip -4 addr show dev "$ETH_IF" 2>/dev/null | grep -q "inet "; then
            printf '%s' "$ETH_IF"
        fi
        return
    fi
    d=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
    if [ -n "$d" ] && [ ! -d "/sys/class/net/$d/wireless" ]; then printf '%s' "$d"; fi
}

resolve_defaults() {
    [ -n "$WIFI_IF" ] || WIFI_IF=$(detect_wifi_if)
    if [ -z "$AP_IF" ]; then
        if [ -n "$WIFI_IF" ] && [ "$(( ${#WIFI_IF} + 2 ))" -le 15 ]; then
            AP_IF="${WIFI_IF}ap"
        else
            AP_IF="wiplex-ap"
        fi
    fi
    [ -n "$DNS_IP" ] || DNS_IP="$AP_IP"
}

# ---- helpers ----------------------------------------------------------------
sta_freq() { iw dev "$WIFI_IF" link 2>/dev/null | awk '/freq:/{print int($2)}'; }
sta_ssid() { iw dev "$WIFI_IF" link 2>/dev/null | awk -F': ' '/SSID:/{print $2; exit}'; }
chan_of_freq() { local f=$1; if [ "$f" -ge 5000 ]; then echo $(( (f - 5000) / 5 )); else echo $(( (f - 2407) / 5 )); fi; }
hwmode_of_freq() { local f=$1; if [ "$f" -ge 5000 ]; then echo a; else echo g; fi; }
is_dfs_channel() {
    local ch=$1 phy
    phy=$(iw dev "$WIFI_IF" info 2>/dev/null | awk '/wiphy/{print "phy"$2}')
    [ -n "$phy" ] || return 1
    iw phy "$phy" info 2>/dev/null | grep -E "\[${ch}\]" | grep -q "radar detection"
}

UPLINK_UUID_FILE="/run/wiplex-uplink.uuid"
uplink_uuid() {
    local u
    if [ -n "${UPLINK_CONN:-}" ]; then
        u=$(nmcli -t -f UUID,NAME connection show 2>/dev/null | awk -F: -v n="$UPLINK_CONN" '$2==n{print $1; exit}')
        if [ -n "$u" ]; then printf '%s\n' "$u" > "$UPLINK_UUID_FILE"; printf '%s' "$u"; return; fi
    fi
    u=$(nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null | awk -F: -v d="$WIFI_IF" '$2==d{print $1; exit}')
    if [ -n "$u" ]; then printf '%s\n' "$u" > "$UPLINK_UUID_FILE"; printf '%s' "$u"; return; fi
    [ -r "$UPLINK_UUID_FILE" ] && cat "$UPLINK_UUID_FILE"
}

wifi_ssid_candidates() {
    nmcli -m multiline -f BSSID,SSID,CHAN,SIGNAL device wifi list 2>/dev/null | awk -v ssid="$1" '
    function val(l) { sub(/^[^:]*:[[:space:]]*/, "", l); return l }
    /^BSSID:/  { if (h && s == ssid && c ~ /^[0-9]+$/) print b, c, g;
                 h = 1; b = val($0); s = ""; c = ""; g = ""; next }
    /^SSID:/   { s = val($0); next }
    /^CHAN:/   { c = val($0); next }
    /^SIGNAL:/ { g = val($0); next }
    END        { if (h && s == ssid && c ~ /^[0-9]+$/) print b, c, g }
    '
}

best_non_dfs_bssid() {
    local ssid="$1" b ch sig best="" bestsig=-999
    while read -r b ch sig; do
        [ -n "$b" ] || continue
        case "$sig" in ''|*[!0-9-]*) continue ;; esac
        is_dfs_channel "$ch" && continue
        if [ "$sig" -gt "$bestsig" ]; then bestsig=$sig; best=$b; fi
    done < <(wifi_ssid_candidates "$ssid")
    [ -n "$best" ] && printf '%s %s' "$best" "$bestsig"
}

# Conservative DFS avoidance: only when the STA is on a DFS channel, with a
# cooldown, pinning the profile to the best non-DFS BSSID (the only method that
# reliably moves NetworkManager). Never signal-based -> no BSSID flipping.
LAST_DFS_TRY=0
avoid_dfs_once() {
    [ "${AVOID_DFS:-yes}" = "yes" ] || return 0
    command -v nmcli >/dev/null 2>&1 || return 0
    local f ch now ssid uuid info best
    f=$(sta_freq); [ -n "$f" ] || return 0
    ch=$(chan_of_freq "$f")
    is_dfs_channel "$ch" || return 0
    now=$(date +%s)
    [ $(( now - LAST_DFS_TRY )) -lt "${DFS_COOLDOWN:-90}" ] && return 0
    LAST_DFS_TRY=$now
    ssid=$(sta_ssid); uuid=$(uplink_uuid)
    [ -n "$ssid" ] && [ -n "$uuid" ] || return 0
    nmcli device wifi rescan >/dev/null 2>&1
    sleep 3
    info=$(best_non_dfs_bssid "$ssid")
    best=${info%% *}
    if [ -z "$best" ]; then log "DFS ch$ch: no non-DFS alternative found"; return 0; fi
    log "DFS ch$ch: pinning to non-DFS $best"
    nmcli connection modify uuid "$uuid" 802-11-wireless.bssid "$best" >/dev/null 2>&1
    nmcli connection up uuid "$uuid" >/dev/null 2>&1
}

handle_stuck_pin() {
    if [ -z "$(sta_freq)" ]; then
        DISCONNECT_SINCE=${DISCONNECT_SINCE:-$(date +%s)}
        if [ $(( $(date +%s) - DISCONNECT_SINCE )) -gt "${STUCK_TIMEOUT:-45}" ]; then
            DISCONNECT_SINCE=$(date +%s)
            local u
            u=$(uplink_uuid)
            if [ -n "$u" ] && [ -n "$(nmcli -g 802-11-wireless.bssid connection show "$u" 2>/dev/null)" ]; then
                log "uplink stuck; clearing BSSID pin and retrying"
                nmcli connection modify uuid "$u" 802-11-wireless.bssid "" >/dev/null 2>&1
                nmcli connection up uuid "$u" >/dev/null 2>&1
            fi
        fi
    else
        DISCONNECT_SINCE=""
    fi
}

# ---- AP / DHCP / NAT --------------------------------------------------------
ensure_ap_if() {
    if ! ip link show "$AP_IF" >/dev/null 2>&1; then
        iw dev "$WIFI_IF" interface add "$AP_IF" type __ap || return 1
        command -v nmcli >/dev/null 2>&1 && nmcli device set "$AP_IF" managed no 2>/dev/null
    fi
    if ! ip -4 addr show dev "$AP_IF" 2>/dev/null | grep -q "$AP_IP/"; then
        ip addr add "$AP_CIDR" dev "$AP_IF" 2>/dev/null
    fi
    ip link set "$AP_IF" up
    return 0
}

write_dnsmasq_conf() {
    {
        echo "interface=$AP_IF"
        echo "bind-dynamic"
        echo "dhcp-range=$DHCP_START,$DHCP_END,$DHCP_MASK,$DHCP_LEASE"
        echo "dhcp-leasefile=/run/wiplex-dnsmasq.leases"
        echo "dhcp-option=3,$AP_IP"
        if [ "$DNS_MODE" = "external" ]; then
            echo "port=0"
            echo "dhcp-option=6,$DNS_IP"
        else
            echo "listen-address=$AP_IP"
            echo "port=$DNS_PORT"
            echo "no-resolv"
            echo "dhcp-option=6,$AP_IP"
            awk '/^nameserver/{print "server="$2}' /etc/resolv.conf
        fi
        echo "log-dhcp"
    } > "$DNSMASQ_CONF"
}

start_dnsmasq() {
    write_dnsmasq_conf
    dnsmasq -k --conf-file="$DNSMASQ_CONF" >>/run/wiplex-dnsmasq.log 2>&1 &
    DNSMASQ_PID=$!
    log "dnsmasq started (pid $DNSMASQ_PID, dns=$DNS_MODE)"
}
restart_dnsmasq() {
    [ -n "$DNSMASQ_PID" ] && kill "$DNSMASQ_PID" 2>/dev/null && wait "$DNSMASQ_PID" 2>/dev/null
    DNSMASQ_PID=""
    start_dnsmasq
}

setup_nat() {
    local up="$1"
    nft delete table ip "$NFT_TABLE" 2>/dev/null
    nft add table ip "$NFT_TABLE"
    nft add chain ip "$NFT_TABLE" postrouting \
        '{ type nat hook postrouting priority srcnat; policy accept; }'
    if [ -n "$up" ]; then
        nft add rule ip "$NFT_TABLE" postrouting ip saddr "$AP_NET" oifname "$up" masquerade
    fi
    sysctl -qw net.ipv4.ip_forward=1
    log "NAT: $AP_NET -> ${up:-none}"
}

start_hostapd() {
    local ch=$1 mode=$2
    {
        echo "interface=$AP_IF"
        echo "driver=nl80211"
        echo "ssid=$SSID"
        echo "hw_mode=$mode"
        echo "channel=$ch"
        echo "ieee80211n=1"
        [ -n "$COUNTRY" ] && { echo "ieee80211d=1"; echo "ieee80211h=1"; echo "country_code=$COUNTRY"; }
        echo "wpa=2"
        [ -n "$PSK" ] && echo "wpa_passphrase=$PSK"
        echo "wpa_key_mgmt=WPA-PSK"
        echo "rsn_pairwise=CCMP"
    } > "$HOSTAPD_CONF"
    hostapd "$HOSTAPD_CONF" >>/run/wiplex-hostapd.log 2>&1 &
    HAPD_PID=$!
    log "hostapd started on channel $ch (hw_mode=$mode, pid $HAPD_PID)"
}
stop_hostapd() {
    if [ -n "$HAPD_PID" ]; then
        kill "$HAPD_PID" 2>/dev/null
        wait "$HAPD_PID" 2>/dev/null
    fi
    HAPD_PID=""
    CHANNEL=""
}
ap_delete() {
    stop_hostapd
    ip addr flush dev "$AP_IF" 2>/dev/null
    iw dev "$AP_IF" del 2>/dev/null
}
ensure_hostapd() {
    local ch=$1 mode=$2
    if [ -z "$HAPD_PID" ] || ! kill -0 "$HAPD_PID" 2>/dev/null || [ "$ch" != "$CHANNEL" ]; then
        stop_hostapd
        CHANNEL=$ch
        start_hostapd "$ch" "$mode"
    fi
}

set_mode() {
    local newmode="$1" newup="$2"
    [ "$newmode" = "$MODE" ] && [ "$newup" = "$UPSTREAM_IF" ] && return
    log "uplink mode: $newmode (${newup:-none})"
    MODE=$newmode
    UPSTREAM_IF=$newup
    DISCONNECT_SINCE=""
    ap_delete   # never touch the STA while an AP vif exists
    if [ "$newmode" = "wired" ]; then
        [ "${FREE_RADIO_ON_WIRED:-yes}" = "yes" ] && nmcli device disconnect "$WIFI_IF" >/dev/null 2>&1
    else
        nmcli device connect "$WIFI_IF" >/dev/null 2>&1
    fi
    setup_nat "$UPSTREAM_IF"
}

# ---- main -------------------------------------------------------------------
resolve_defaults
[ -n "$WIFI_IF" ] || die "no WiFi interface found; set WIFI_IF in $CONF"
[ -n "$COUNTRY" ] && { iw reg set "$COUNTRY" 2>/dev/null || true; }

start_dnsmasq

while true; do
    if [ "$RELOAD" = 1 ]; then
        RELOAD=0
        # shellcheck disable=SC1090
        . "$CONF" 2>/dev/null || true
        resolve_defaults
        ap_delete
        setup_nat "$UPSTREAM_IF"
        restart_dnsmasq
        continue
    fi

    eth=$(wired_uplink)
    if [ -n "$eth" ]; then
        set_mode wired "$eth"
        ensure_ap_if >/dev/null 2>&1
        ensure_hostapd "$AP_CHANNEL" "$([ "$AP_BAND" = "5" ] && echo a || echo g)"
    else
        set_mode duplex "$WIFI_IF"
        handle_stuck_pin
        f=$(sta_freq)
        if [ -n "$f" ] && [ "$f" -gt 0 ]; then
            ch=$(chan_of_freq "$f")
            if is_dfs_channel "$ch"; then
                ap_delete
                avoid_dfs_once
            else
                ensure_ap_if >/dev/null 2>&1
                ensure_hostapd "$ch" "$(hwmode_of_freq "$f")"
            fi
        else
            ap_delete   # no uplink: keep the radio free for the client
        fi
    fi
    sleep 3
done
